FROM php:8.4-fpm

# Install system dependencies + nginx + supervisor
RUN apt-get update && apt-get install -y \
    nginx \
    supervisor \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    libzip-dev \
    libjpeg-dev \
    libfreetype6-dev \
    unzip \
    git \
    curl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# PHP extensions required by composer.json (intl, mbstring) + mysqli/pdo_mysql for DB + zip/gd used by CI4
RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install pdo_mysql mysqli mbstring intl zip gd exif

# Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

WORKDIR /var/www

# Copy application code (built from the www/ folder)
COPY www/ /var/www/

# Install PHP dependencies (production only, no dev tools like phpunit/faker)
RUN composer install --no-dev --optimize-autoloader --no-interaction

# Permissions for CodeIgniter's writable directory (cache, logs, uploads, sessions)
RUN chown -R www-data:www-data /var/www/writable \
    && chmod -R 775 /var/www/writable

# PHP upload/memory settings (same as your local docker-compose/PHP/uploads.ini)
RUN { \
    echo "file_uploads = On"; \
    echo "memory_limit = 256M"; \
    echo "upload_max_filesize = 256M"; \
    echo "post_max_size = 256M"; \
    echo "max_execution_time = 1000"; \
    } > /usr/local/etc/php/conf.d/uploads.ini

# Nginx config template (port gets substituted at container start, since Railway assigns $PORT dynamically)
COPY railway/nginx.conf.template /etc/nginx/templates/default.conf.template

# Supervisor config to run nginx + php-fpm together
COPY railway/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

# Start script: fills in $PORT, then hands off to supervisor
COPY railway/start.sh /start.sh
RUN chmod +x /start.sh

EXPOSE 8080

CMD ["/start.sh"]
